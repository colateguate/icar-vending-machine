# The original challenge statement is kept locally for reference but must never
# enter the public repository (it contains the company name, which the brief
# forbids from appearing anywhere in the code or history).
CHALLENGE-DESCRIPTION.md

# Local editor/agent settings not meant for the public repo
.setting/
.claude/settings.local.json

# PHP / Symfony
backend/vendor/
backend/var/
backend/.env.local
backend/.env.*.local
backend/.phpunit.cache/
backend/.php-cs-fixer.cache

# Node / React
frontend/node_modules/
frontend/dist/
frontend/coverage/

# Playwright writes both of these on a failing run: traces, screenshots and the
# HTML report. Artefacts of one execution, never of the repository.
frontend/test-results/
frontend/playwright-report/

# Vite bakes every VITE_* variable into the shipped bundle, so a local override
# is public the moment it is built. Ignored before there is one to leak.
frontend/.env.local
frontend/.env.*.local

# OS / editor noise
.DS_Store
Thumbs.db

# Personal study notes (Spanish) — not part of the deliverable
documentation/
