{
    // Mutation testing, deliberately scoped to the business core: mutating
    // infrastructure glue produces noise; MSI over Domain + Application is
    // the number that says "these tests would catch a regression".
    "$schema": "vendor/infection/infection/resources/schema.json",
    "source": {
        "directories": [
            "src/VendingMachine/Domain",
            "src/VendingMachine/Application"
        ]
    },
    // Only the suites that are supposed to kill these mutants run here. An
    // acceptance test killing a domain mutant proves nothing a unit test did
    // not already prove, and it drags a kernel boot into every mutant run:
    // the same suite costs 0.01s scoped versus 5.5s unscoped.
    // Note the "=" form: Infection forwards this string as a single argv
    // entry, so a space-separated option would reach PHPUnit as one unknown
    // option name.
    "testFrameworkOptions": "--testsuite=unit,application",
    "timeout": 30,
    "logs": {
        "text": "var/infection.log"
    },
    "mutators": {
        "@default": true
    },
    "minMsi": 85,
    "minCoveredMsi": 90
}
