###> symfony/framework-bundle ###
# Generated by the Flex recipe as a random hex string, and replaced by hand with
# something nobody has to think twice about. It was never a secret — it is the
# development value of a parameter this API does not use, because there are no
# sessions, no cookies and nothing signed — but a hex blob in a public
# repository invites the question, and the answer costs more than the line.
#
# The container gets its own through the environment (docker-compose.yml).
APP_SECRET=development-only-this-api-signs-nothing
###< symfony/framework-bundle ###
